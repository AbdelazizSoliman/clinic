# Copy to .env and replace every change-me value before starting anything. Full
# instructions, in order, are in docs/installation.md.
#
# Order matters: POSTGRES_* must be real values before any compose command runs,
# because compose.yaml refuses to interpolate without them. Generate them first,
# build the image, then generate the remaining secrets inside the image:
#   openssl rand -hex 32                                      # POSTGRES_PASSWORD
#   docker compose build web
#   docker compose run --rm --no-deps web ./bin/rails secret  # SECRET_KEY_BASE, SECURITY_EVENT_DIGEST_KEY
#   docker compose run --rm --no-deps web ./bin/rails db:encryption:init   # the three ACTIVE_RECORD_ENCRYPTION_* values
# Generate ADMIN_PASSWORD with a password manager; use at least 12 random characters.
#
# Then validate the finished file, before any database is created:
#   docker compose run --rm --no-deps web ./bin/rails installation:preflight
# --no-deps is required. Without it compose starts db and runs the prepare service
# first, so the database is created before preflight has validated the configuration.
# DATABASE_URL is not set here; compose.yaml builds it from the POSTGRES_* values.

# Rails/application — REQUIRED for the supported Compose evaluation profile
RAILS_ENV=production
INSTALLATION_PROFILE=buyer_evaluation
APP_HOST=localhost
ALLOWED_HOSTS=localhost,127.0.0.1
FORCE_SSL=false
APP_PROTOCOL=http
RAILS_SERVE_STATIC_FILES=true
SECRET_KEY_BASE=change-me-generate-with-bin-rails-secret
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=change-me-random-32-plus-characters
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=change-me-random-32-plus-characters
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=change-me-random-32-plus-characters
SECURITY_EVENT_DIGEST_KEY=change-me-random-32-plus-characters
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
DATABASE_POOL=5

# PostgreSQL — REQUIRED; Compose constructs DATABASE_URL from these values
POSTGRES_DB=clinic_production
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-long-random-database-password

# First tenant administrator — REQUIRED only when running users:create_admin
ADMIN_ORGANIZATION_CODE=DEFAULT
ADMIN_BRANCH_CODE=MAIN
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=change-me-at-least-12-random-characters
ADMIN_FIRST_NAME=Installation
ADMIN_LAST_NAME=Administrator
ADMIN_MOBILE=+201000000000

# Mail — Mailpit is bundled for evaluation; use authenticated SMTP in production
SMTP_ADDRESS=mailpit
SMTP_PORT=1025
SMTP_AUTHENTICATION=none
SMTP_STARTTLS=false
MAIL_FROM_EMAIL=no-reply@example.test
MAIL_FROM_NAME=Saydaliyati
MAILPIT_WEB_PORT=8025
# SMTP_USERNAME=required-for-production-provider
# SMTP_PASSWORD=required-for-production-provider

# Storage — persistent local volume is evaluation-only; production requires private S3-compatible storage
STORAGE_SERVICE=local
# STORAGE_ACCESS_KEY_ID=required-for-s3
# STORAGE_SECRET_ACCESS_KEY=required-for-s3
# STORAGE_REGION=required-for-s3
# STORAGE_BUCKET=required-for-s3
# STORAGE_ENDPOINT=optional-for-s3-compatible-storage
# STORAGE_FORCE_PATH_STYLE=false

# Prescription upload scanning — REQUIRED and bundled in Compose
MALWARE_SCANNER_ADAPTER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
SCANNER_TIMEOUT_SECONDS=10

# Worker/database tuning — OPTIONAL
JOB_CONCURRENCY=1
DB_STATEMENT_TIMEOUT=15s
DB_LOCK_TIMEOUT=3s
DB_IDLE_TRANSACTION_TIMEOUT=30s

# Operational/integration settings — OPTIONAL
DEMO_MODE=false
ERROR_REPORTER_ADAPTER=logging
REPORT_EXPORT_RETENTION_DAYS=7
RELEASE_SHA=local
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
