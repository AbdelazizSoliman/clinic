<main class="mx-auto max-w-6xl px-4 py-10" dir="rtl"><h1 class="text-3xl font-black">النقاط والمحفظة</h1><div class="mt-6 grid gap-4 md:grid-cols-2"><section class="rounded-2xl bg-white p-6 shadow"><h2 class="text-xl font-black">نقاط الولاء</h2><p class="mt-3 text-4xl font-black"><%= @loyalty_account&.points_balance.to_i %></p><p>إجمالي المكتسب: <%= @loyalty_account&.lifetime_earned_points.to_i %></p></section><section class="rounded-2xl bg-white p-6 shadow"><h2 class="text-xl font-black">رصيد المحفظة</h2><p class="mt-3 text-4xl font-black"><%= number_to_currency(@wallet_account&.balance_cents.to_i / 100.0, unit: "ج.م") %></p><p class="text-sm text-slate-500">لا يمكن السحب النقدي أو التحويل.</p></section></div><div class="mt-8 grid gap-6 md:grid-cols-2"><section><h2 class="text-xl font-black">سجل النقاط</h2><% @loyalty_entries.each do |entry| %><article class="mt-2 rounded-xl bg-white p-4"><strong><%= entry.entry_type %> · <%= entry.points %> نقطة</strong><p class="text-sm"><%= entry.reason %></p><time class="text-xs"><%= l(entry.occurred_at, format: :short) %></time></article><% end %></section><section><h2 class="text-xl font-black">سجل المحفظة</h2><% @wallet_entries.each do |entry| %><article class="mt-2 rounded-xl bg-white p-4"><strong><%= entry.entry_type %> · <%= entry.amount_cents %> قرش</strong><p class="text-sm"><%= entry.reason %></p><time class="text-xs"><%= l(entry.occurred_at, format: :short) %></time></article><% end %></section></div></main>
