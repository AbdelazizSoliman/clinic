<% if products.empty? %><p class="rounded-xl bg-rose-50 p-3 text-rose-800">لا يوجد منتج مطابق.</p><% end %>
<% products.each do |product| %><article class="flex items-center justify-between gap-3 rounded-xl border p-3"><div><strong><%= product.name %></strong><small class="block text-slate-500"><%= product.sku %> · المتاح <%= product.available_to_sell_quantity %><%= " · روشتة" if product.requires_prescription? %></small></div><% if sale %><%= button_to "إضافة", pos_sale_items_path(sale), params: { product_id: product.id, quantity: 1 }, class: "rounded-lg bg-pharmacy-700 px-3 py-2 text-white", disabled: !product.available? %><% end %></article><% end %>
