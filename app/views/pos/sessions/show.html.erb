<div class="mx-auto max-w-4xl px-4 py-8"><h1 class="text-3xl font-black">جلسة الصندوق</h1><p class="mt-2" dir="ltr"><%= @session.identifier %></p><dl class="mt-6 grid gap-3 rounded-2xl bg-white p-5 sm:grid-cols-2"><dt>الكاشير</dt><dd><%= @session.user.full_name %></dd><dt>رصيد البداية</dt><dd><%= number_to_currency(@session.opening_cash_cents / 100.0, unit: "ج.م") %></dd><dt>المتوقع حاليًا</dt><dd><%= number_to_currency((@session.expected_cash_cents || @session.expected_cash) / 100.0, unit: "ج.م") %></dd><dt>الحالة</dt><dd><%= @session.status %></dd><% if @session.closed? %><dt>المعدود</dt><dd><%= number_to_currency(@session.closing_cash_counted_cents / 100.0, unit: "ج.م") %></dd><dt>الفرق</dt><dd><%= number_to_currency(@session.cash_difference_cents / 100.0, unit: "ج.م") %></dd><% end %></dl><% if @session.open? %><%= form_with url: close_pos_session_path(@session.identifier), method: :patch, class: "mt-6 grid gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-5" do %><%= hidden_field_tag :lock_version, @session.lock_version %><div><%= label_tag :closing_cash_counted_cents, "النقد المعدود بالقرش" %><%= number_field_tag :closing_cash_counted_cents, @session.expected_cash, min: 0, required: true, class: "mt-1 w-full rounded-xl border p-3" %></div><div><%= label_tag :notes, "ملاحظة التسوية" %><%= text_area_tag :notes, nil, class: "mt-1 w-full rounded-xl border p-3" %></div><%= submit_tag "إغلاق الجلسة", class: "rounded-xl bg-amber-700 p-3 font-bold text-white" %><% end %><% end %></div>
