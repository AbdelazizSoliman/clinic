<article class="mx-auto mt-6 max-w-xl bg-white p-6 text-slate-950 print:mt-0 print:shadow-none"><header class="border-b pb-4 text-center"><h1 class="text-2xl font-black"><%= PharmacySetting.first&.pharmacy_name || "صيدليتي" %></h1><p>إيصال نقطة بيع</p><strong dir="ltr"><%= sale.number %></strong></header><dl class="mt-4 grid grid-cols-2 gap-1 text-sm"><dt>الكاشير</dt><dd><%= sale.cashier.full_name %></dd><dt>التاريخ</dt><dd><%= l(sale.completed_at || sale.created_at, format: :short) %></dd></dl><table class="mt-5 w-full text-right text-sm"><thead><tr><th>الصنف</th><th>الكمية</th><th>السعر</th><th>الإجمالي</th></tr></thead><tbody><% sale.items.each do |item| %><tr class="border-t"><td class="py-2"><%= item.product_name %><%= " · اعتماد صيدلي" if item.requires_prescription? %></td><td><%= item.quantity %></td><td><%= number_to_currency(item.unit_price_cents / 100.0, unit: "ج.م") %></td><td><%= number_to_currency(item.line_total_cents / 100.0, unit: "ج.م") %></td></tr><% end %></tbody></table><dl class="mt-5 grid grid-cols-2 gap-2 border-t pt-4"><dt>الإجمالي الخام</dt><dd><%= number_to_currency(sale.subtotal_cents / 100.0, unit: "ج.م") %></dd><dt>الخصم</dt><dd><%= number_to_currency((sale.automatic_discount_cents + sale.manual_discount_cents) / 100.0, unit: "ج.م") %></dd><dt class="font-black">الإجمالي</dt><dd class="font-black"><%= number_to_currency(sale.total_cents / 100.0, unit: "ج.م") %></dd><% sale.payments.each do |payment| %><dt><%= payment.cash? ? "نقدي" : "بطاقة خارجية" %></dt><dd><%= number_to_currency(payment.amount_cents / 100.0, unit: "ج.م") %></dd><% if payment.cash? %><dt>المستلم</dt><dd><%= number_to_currency(payment.tendered_cents / 100.0, unit: "ج.م") %></dd><dt>الباقي</dt><dd><%= number_to_currency(payment.change_cents / 100.0, unit: "ج.م") %></dd><% end %><% end %></dl><button onclick="window.print()" class="mt-6 w-full rounded-xl bg-slate-900 p-3 font-bold text-white print:hidden">طباعة الإيصال</button></article>
