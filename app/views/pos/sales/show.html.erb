<% content_for :title, "بيع #{@sale.number}" %>
<div class="mx-auto max-w-7xl px-4 py-6" data-controller="pos">
  <div class="flex flex-wrap items-center justify-between gap-3 print:hidden"><div><h1 class="text-3xl font-black">نقطة البيع</h1><span dir="ltr"><%= @sale.number %></span> · <%= @sale.status %></div><%= link_to "الرئيسية", pos_root_path, class: "rounded-xl border px-4 py-2" %></div>
  <% if @sale.draft? %>
    <div class="mt-5 grid gap-5 lg:grid-cols-[1fr_1.4fr]">
      <section class="rounded-2xl bg-white p-5 shadow-sm">
        <h2 class="text-xl font-black">المسح والبحث</h2>
        <%= form_with url: pos_sale_items_path(@sale), class: "mt-4 flex gap-2" do %><%= text_field_tag :barcode, nil, required: true, autocomplete: "off", placeholder: "امسح أو اكتب الباركود", class: "min-w-0 flex-1 rounded-xl border-2 p-4 text-lg", dir: "ltr", data: { pos_target: "barcode" } %><%= submit_tag "إضافة", class: "rounded-xl bg-pharmacy-700 px-5 font-black text-white" %><% end %>
        <label class="mt-5 block font-bold">بحث بالاسم العربي أو الإنجليزي أو SKU</label><%= search_field_tag :q, nil, autocomplete: "off", class: "mt-1 w-full rounded-xl border p-3", data: { pos_target: "search", action: "input->pos#search", url: pos_products_path, sale_number: @sale.number } %><div class="mt-3 space-y-2" data-pos-target="results"></div>
        <p class="mt-4 text-xs text-slate-500">Enter يضيف الباركود. لا يوجد التقاط عام للوحة المفاتيح.</p>
      </section>
      <section class="rounded-2xl bg-white p-5 shadow-sm"><h2 class="text-xl font-black">السلة</h2><div class="mt-4 space-y-3"><% @sale.items.each do |item| %><article class="rounded-xl border p-4"><div class="flex justify-between gap-3"><div><strong><%= item.product_name %></strong><small class="block text-slate-500"><%= item.product_sku %> · متاح <%= item.product.available_to_sell_quantity %></small><% if item.requires_prescription? %><span class="mt-2 inline-block rounded bg-amber-100 px-2 py-1 text-xs font-bold">يتطلب اعتماد صيدلي</span><% end %></div><strong><%= number_to_currency(item.line_total_cents / 100.0, unit: "ج.م") %></strong></div><div class="mt-3 flex flex-wrap items-end gap-2"><%= form_with url: pos_sale_item_path(@sale, item), method: :patch, class: "flex items-end gap-2" do %><div><%= label_tag :quantity, "الكمية", class: "text-xs" %><%= number_field_tag :quantity, item.quantity, min: 1, class: "block w-20 rounded-lg border p-2" %></div><%= submit_tag "تحديث", class: "rounded-lg border px-3 py-2" %><% end %><%= button_to "حذف", pos_sale_item_path(@sale, item), method: :delete, class: "rounded-lg text-rose-700" %></div>
        <% if item.requires_prescription? %><% review_item = item.prescription_review_item %><% if review_item&.terminal? %><div class="mt-3 rounded-lg bg-slate-50 p-3 text-sm"><strong><%= review_item.status %></strong> · الموصوف: <%= review_item.original_product.name %><% if review_item.dispensable? %> · المصروف: <%= review_item.dispensed_product.name %><% end %> · <%= review_item.reviewed_by.full_name %></div><% elsif current_user.can_approve_pos_prescriptions? %><%= form_with url: pos_sale_approve_prescription_path(@sale, item), class: "mt-3 grid gap-2 rounded-lg border p-3" do %><%= hidden_field_tag :lock_version, review_item&.lock_version %><%= text_field_tag :reason, nil, required: true, placeholder: "سبب القرار دون بيانات طبية حساسة", class: "rounded-lg border p-2" %><div data-controller="product-search" data-product-search-url-value="<%= staff_substitution_candidates_path %>" data-search-param-exclude_id="<%= item.product_id %>" data-search-param-field_id="pos_substitute_<%= item.id %>"><%= label_tag "pos_substitute_search_#{item.id}", "ابحث عن بديل علاجي اختياري", class: "text-xs font-bold" %><%= search_field_tag "pos_substitute_search_#{item.id}", nil, id: "pos_substitute_search_#{item.id}", autocomplete: "off", data: { product_search_target: "input", action: "input->product-search#search keydown->product-search#navigate" }, class: "mt-1 w-full rounded-lg border p-2" %><span data-product-search-target="status" class="hidden text-xs text-slate-500" role="status">جارٍ البحث…</span><div data-product-search-target="panel" class="mt-2 hidden rounded-lg border p-2" aria-live="polite"></div></div><div class="grid grid-cols-3 gap-2"><button name="decision" value="approved" class="rounded-lg bg-emerald-700 p-2 text-white">اعتماد</button><button name="decision" value="substituted" class="rounded-lg bg-blue-700 p-2 text-white">استبدال</button><button name="decision" value="rejected" class="rounded-lg bg-rose-700 p-2 text-white">رفض</button></div><% end %><% end %><% end %>
        <% if item.prescription_review_item %><%= render "drug_safety/findings", item: item.prescription_review_item, findings: safety_findings_for(@safety_findings, item.prescription_review_item), can_resolve: current_user.can_resolve_safety_findings? %><% end %></article><% end %><% if @sale.items.empty? %><p class="text-slate-500">السلة فارغة.</p><% end %></div></section>
    </div>
    <% if @safety_evaluation || @safety_findings.any? %><%= render "drug_safety/banner", findings: @safety_findings, evaluation: @safety_evaluation %><% end %>
    <section class="mt-5 grid gap-5 rounded-2xl bg-slate-900 p-6 text-white lg:grid-cols-2"><div><dl class="grid grid-cols-2 gap-2"><dt>الإجمالي الخام</dt><dd><%= number_to_currency(@sale.subtotal_cents / 100.0, unit: "ج.م") %></dd><dt>خصومات تلقائية</dt><dd><%= number_to_currency(@sale.automatic_discount_cents / 100.0, unit: "ج.م") %></dd><dt>خصم يدوي</dt><dd><%= number_to_currency(@sale.manual_discount_cents / 100.0, unit: "ج.م") %></dd><dt class="text-xl font-black">المطلوب</dt><dd class="text-xl font-black"><%= number_to_currency(@sale.total_cents / 100.0, unit: "ج.م") %></dd></dl><% if current_user.can_approve_pos_discounts? %><%= form_with url: pos_sale_approve_discount_path(@sale), class: "mt-4 flex flex-wrap gap-2" do %><%= number_field_tag :amount_cents, nil, min: 1, required: true, placeholder: "الخصم بالقرش", class: "rounded-lg p-2 text-slate-900" %><%= text_field_tag :reason, nil, required: true, placeholder: "سبب الخصم", class: "rounded-lg p-2 text-slate-900" %><%= submit_tag "اعتماد الخصم", class: "rounded-lg bg-amber-500 px-3 font-bold text-slate-950" %><% end %><% end %></div>
      <%= form_with url: complete_pos_sale_path(@sale), class: "grid gap-3" do %><%= hidden_field_tag :idempotency_key, @idempotency_key %><%= hidden_field_tag :amount_cents, @sale.total_cents %><div><%= label_tag :payment_method, "طريقة الدفع" %><%= select_tag :payment_method, options_for_select([["نقدي","cash"],["بطاقة عبر جهاز خارجي","external_card"]]), class: "mt-1 w-full rounded-xl p-3 text-slate-900" %></div><div><%= label_tag :tendered_cents, "النقد المستلم بالقرش" %><%= number_field_tag :tendered_cents, @sale.total_cents, min: @sale.total_cents, class: "mt-1 w-full rounded-xl p-3 text-slate-900" %></div><div><%= label_tag :external_reference, "مرجع الجهاز الخارجي (غير حساس)" %><%= text_field_tag :external_reference, nil, class: "mt-1 w-full rounded-xl p-3 text-slate-900" %></div><%= submit_tag "إتمام البيع", class: "rounded-xl bg-emerald-500 p-4 text-lg font-black text-slate-950", data: { turbo_confirm: "إتمام البيع سيستهلك المخزون نهائيًا. متابعة؟" } %><% end %></section>
    <%= form_with url: void_pos_sale_path(@sale), method: :patch, class: "mt-5 flex gap-2 print:hidden" do %><%= text_field_tag :reason, nil, required: true, placeholder: "سبب إلغاء المسودة", class: "flex-1 rounded-xl border p-3" %><%= submit_tag "إلغاء المسودة", class: "rounded-xl bg-rose-700 px-5 text-white" %><% end %>
  <% else %>
    <%= render "receipt", sale: @sale %>
  <% end %>
</div>
