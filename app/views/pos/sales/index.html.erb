<div class="mx-auto max-w-7xl px-4 py-8"><div class="flex justify-between"><h1 class="text-3xl font-black">سجل مبيعات نقطة البيع</h1><%= link_to "نقطة البيع", pos_root_path, class: "rounded-xl border px-4 py-2" %></div><div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full text-right"><thead><tr><th class="p-3">الإيصال</th><th>الحالة</th><th>الكاشير</th><th>الإجمالي</th><th>الوقت</th></tr></thead><tbody><% @sales.each do |sale| %><tr class="border-t"><td class="p-3"><%= link_to sale.number, pos_sale_path(sale), dir: "ltr" %></td><td><%= sale.status %></td><td><%= sale.cashier.full_name %></td><td><%= number_to_currency(sale.total_cents / 100.0, unit: "ج.م") %></td><td><%= l(sale.completed_at || sale.created_at, format: :short) %></td></tr><% end %></tbody></table></div></div>
