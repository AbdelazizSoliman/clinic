<div class="mx-auto max-w-xl px-4 py-12 text-center"><h1 class="text-3xl font-black">عملية بيع جديدة</h1><p class="mt-3 text-slate-600">اترك العميل فارغاً للبيع المجهول.</p><%= form_with url: pos_sales_path, class: "mt-6 grid gap-3" do %><%= email_field_tag :customer_email, nil, placeholder: "بريد العميل الاختياري", class: "rounded border p-3" %><%= submit_tag "إنشاء المسودة", class: "rounded-xl bg-pharmacy-700 px-7 py-4 font-black text-white" %><% end %></div>
