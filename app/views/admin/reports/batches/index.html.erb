<div class="mx-auto max-w-7xl px-4 py-10"><h1 class="text-3xl font-black">تقرير التشغيلات والصلاحية</h1><%= render "admin/reports/filters" %><%= render "admin/reports/export", report_type: "batches" %><div class="mt-6 grid gap-3 sm:grid-cols-4"><% @report.cards.each do |label, value| %><div class="rounded-2xl bg-white p-5"><small><%= label %></small><strong class="block text-2xl"><%= value %></strong></div><% end %></div><p class="mt-5 rounded-xl bg-white p-4">قيمة المخزون بتكلفة الاستلام: <strong><%= number_to_currency(@report.valuation_cents / 100.0, unit: "ج.م") %></strong></p><div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full min-w-[800px] text-right"><thead><tr><th class="p-4">التشغيلة</th><th>المنتج</th><th>الصلاحية</th><th>الحالة</th><th>فعلي</th><th>محجوز</th><th>متاح</th></tr></thead><tbody><% @report.batches.each do |batch| %><tr class="border-t"><td class="p-4"><%= link_to batch.batch_number, admin_inventory_batch_path(batch) %></td><td><%= batch.product.name %></td><td><%= batch.expiry_date %></td><td><%= batch.lifecycle_status %></td><td><%= batch.on_hand_quantity %></td><td><%= batch.reserved_quantity %></td><td><%= batch.available_quantity %></td></tr><% end %></tbody></table></div></div>
