<% content_for :title, "تقرير المشتريات" %><div class="mx-auto max-w-7xl px-4 py-10"><div class="flex flex-wrap justify-between gap-4"><h1 class="text-3xl font-black">تقرير المشتريات</h1><%= render "admin/reports/export" %></div><%= render "admin/reports/filters" %><div class="mt-7 grid gap-4 sm:grid-cols-3 lg:grid-cols-6"><% @report.cards.each do |name, value| %><div class="rounded-2xl bg-white p-5"><span class="text-sm text-slate-500"><%= name %></span><strong class="block text-xl"><%= name.to_s.end_with?("cents") ? number_to_currency(value / 100.0, unit: "ج.م") : value %></strong></div><% end %></div><div class="mt-7 grid gap-6 lg:grid-cols-2"><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">المشتريات المستلمة حسب المورد</h2><table class="mt-3 w-full text-right"><% @report.supplier_totals.each do |(_id, name), cents| %><tr class="border-t"><td class="p-3"><%= name %></td><td><%= number_to_currency(cents / 100.0, unit: "ج.م") %></td></tr><% end %></table></section><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">أكثر المنتجات استلامًا</h2><table class="mt-3 w-full text-right"><% @report.top_products.each do |(_id, name), quantity| %><tr class="border-t"><td class="p-3"><%= name %></td><td><%= quantity %></td></tr><% end %></table></section></div><section class="mt-7 rounded-2xl bg-white p-5"><h2 class="text-xl font-black">الأوامر القائمة والمتأخرة</h2><div class="mt-3 overflow-x-auto"><table class="w-full min-w-[700px] text-right"><thead><tr><th class="p-3">الأمر</th><th>المورد</th><th>الحالة</th><th>المتبقي</th><th>المتوقع</th></tr></thead><tbody><% @report.outstanding.each do |order| %><tr class="border-t <%= 'bg-rose-50' if order.expected_at && order.expected_at < Date.current %>"><td class="p-3"><%= link_to order.number, admin_purchase_order_path(order), class: "font-bold text-pharmacy-700" %></td><td><%= order.supplier.name %></td><td><%= order.status %></td><td><%= order.outstanding_quantity %></td><td><%= order.expected_at || "—" %></td></tr><% end %></tbody></table></div></section><section class="mt-7 rounded-2xl bg-white p-5"><h2 class="text-xl font-black">أحدث تكلفة شراء</h2><div class="mt-3 overflow-x-auto"><table class="w-full min-w-[650px] text-right"><thead><tr><th class="p-3">المنتج</th><th>التكلفة</th><th>آخر استلام</th></tr></thead><tbody><% @report.latest_costs.each do |row| %><tr class="border-t"><td class="p-3"><%= row.product_name_snapshot %></td><td><%= number_to_currency(row.unit_cost_cents / 100.0, unit: "ج.م") %></td><td><%= l(row.received_at, format: :short) %></td></tr><% end %></tbody></table></div></section></div>
