<div class="mx-auto max-w-7xl px-4 py-10"><div class="flex flex-wrap justify-between gap-3"><div><h1 class="text-3xl font-black">تقارير نقطة البيع</h1><p class="mt-2 text-slate-600">المبيعات والتسويات وتتبع التشغيلات ضمن توقيت القاهرة.</p></div><%= link_to "تصدير CSV", admin_reports_pos_index_path(request.query_parameters.merge(format: :csv)), class: "rounded-xl bg-slate-900 px-4 py-3 text-white" %></div><%= render "admin/reports/filters" %><div class="mt-6 grid gap-4 sm:grid-cols-4"><% [["الإيصالات",@report.cards[:sales]],["الصافي (قرش)",@report.cards[:net_cents]],["الخصومات (قرش)",@report.cards[:discounts_cents]],["فرق الصندوق (قرش)",@report.cards[:cash_difference_cents]]].each do |label,value| %><div class="rounded-xl bg-white p-4"><small><%= label %></small><strong class="mt-2 block text-2xl"><%= value %></strong></div><% end %></div><div class="mt-7 grid gap-5 lg:grid-cols-2"><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">حسب الكاشير</h2><ul class="mt-3"><% @report.by_cashier.each do |(_id, first, last), cents| %><li class="border-t py-2"><%= first %> <%= last %> — <%= cents %> قرش</li><% end %></ul></section><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">طرق الدفع</h2><ul class="mt-3"><% @report.payment_totals.each do |method,cents| %><li class="border-t py-2"><%= method %> — <%= cents %> قرش</li><% end %></ul></section><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">أكثر المنتجات</h2><ul class="mt-3"><% @report.top_products.each do |name,quantity| %><li class="border-t py-2"><%= name %> — <%= quantity %></li><% end %></ul></section><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">فروق التسوية</h2><ul class="mt-3"><% @report.reconciliation_differences.each do |session| %><li class="border-t py-2"><%= session.identifier %> · <%= session.user.full_name %> · <%= session.cash_difference_cents %> قرش</li><% end %></ul></section></div><section class="mt-5 rounded-2xl bg-white p-5"><h2 class="text-xl font-black">تتبع استهلاك التشغيلات</h2><div class="mt-3 overflow-x-auto"><table class="w-full text-right"><thead><tr><th>الإيصال</th><th>التشغيلة</th><th>الكمية</th><th>التكلفة</th></tr></thead><tbody><% @report.batch_allocations.each do |allocation| %><tr class="border-t"><td><%= allocation.pos_sale_item.pos_sale.number %></td><td><%= allocation.inventory_batch.batch_number %></td><td><%= allocation.quantity %></td><td><%= allocation.unit_cost_cents %></td></tr><% end %></tbody></table></div></section></div>
