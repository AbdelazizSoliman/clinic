<% content_for :title, "مرادفات البحث" %>
<div class="mx-auto max-w-7xl px-4 py-10">
  <div class="flex flex-wrap items-center justify-between gap-4"><h1 class="text-3xl font-black">مرادفات البحث</h1><%= link_to "مرادف جديد", new_admin_search_synonym_path, class: "rounded-xl bg-pharmacy-700 px-5 py-3 font-bold text-white" %></div>
  <p class="mt-2 rounded-xl bg-amber-50 p-4 text-sm">توسيع لغوي لعبارات البحث فقط — لا يمثل تكافؤًا علاجيًا ولا يؤثر على قواعد السلامة أو قرارات الصيدلي.</p>
  <%= form_with url: admin_search_synonyms_path, method: :get, class: "mt-6 grid gap-3 rounded-2xl bg-white p-4 sm:grid-cols-3" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: "المصطلح أو البديل", class: "rounded-xl border p-3" %>
    <%= f.select :active, [["كل الحالات", ""], ["مفعّل", "true"], ["موقوف", "false"]], { selected: params[:active] }, class: "rounded-xl border p-3" %>
    <%= f.submit "بحث", class: "rounded-xl bg-slate-900 p-3 text-white" %>
  <% end %>
  <p class="mt-4"><%= @pagy.count %> مرادف</p>
  <div class="mt-4 overflow-x-auto rounded-2xl bg-white"><table class="w-full min-w-[640px] text-right"><thead class="bg-slate-50"><tr><th class="p-4">المصطلح</th><th>يُبحث أيضًا عن</th><th>الحالة</th></tr></thead><tbody>
    <% @synonyms.each do |synonym| %><tr class="border-t"><td class="p-4"><%= link_to synonym.term, admin_search_synonym_path(synonym), class: "font-black text-pharmacy-700" %></td><td><%= synonym.expansion %></td><td><%= synonym.active? ? "مفعّل" : "موقوف" %></td></tr><% end %>
  </tbody></table></div>
</div>
