<% content_for :title, @synonym.term %>
<div class="mx-auto max-w-3xl px-4 py-10">
  <%= link_to "← مرادفات البحث", admin_search_synonyms_path, class: "font-bold text-pharmacy-700" %>
  <div class="mt-4 rounded-2xl bg-white p-6">
    <h1 class="text-3xl font-black"><%= @synonym.term %> ← <%= @synonym.expansion %></h1>
    <p class="mt-2 text-sm text-slate-600">بعد التوحيد: <span dir="auto"><%= @synonym.normalized_term %></span> ← <span dir="auto"><%= @synonym.normalized_expansion %></span></p>
    <p class="mt-1 font-bold"><%= @synonym.active? ? "مفعّل" : "موقوف" %></p>
    <% if @synonym.notes.present? %><p class="mt-3 text-sm"><%= @synonym.notes %></p><% end %>
    <p class="mt-4 rounded-xl bg-amber-50 p-3 text-sm">توسيع بحث فقط — بلا أي دلالة علاجية.</p>
    <div class="mt-5 flex gap-2">
      <%= link_to "تعديل", edit_admin_search_synonym_path(@synonym), class: "rounded-xl border px-4 py-2 font-bold" %>
      <% if @synonym.active? %><%= button_to "إيقاف", deactivate_admin_search_synonym_path(@synonym), method: :patch, class: "rounded-xl border px-4 py-2 font-bold" %><% end %>
    </div>
  </div>
</div>
