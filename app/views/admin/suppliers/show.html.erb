<% content_for :title, @supplier.name %><div class="mx-auto max-w-6xl px-4 py-10">
  <div class="flex flex-wrap items-center justify-between gap-4"><div><p class="text-sm text-slate-500" dir="ltr"><%= @supplier.code %></p><h1 class="text-3xl font-black"><%= @supplier.name %></h1></div><div class="flex gap-2"><%= link_to "تعديل", edit_admin_supplier_path(@supplier), class: "rounded-xl border px-4 py-2" %><% if @supplier.active? %><%= button_to "إيقاف", deactivate_admin_supplier_path(@supplier), method: :patch, class: "rounded-xl bg-amber-600 px-4 py-2 text-white" %><% else %><%= button_to "تفعيل", activate_admin_supplier_path(@supplier), method: :patch, class: "rounded-xl bg-emerald-700 px-4 py-2 text-white" %><% end %></div></div>
  <dl class="mt-6 grid gap-4 rounded-2xl bg-white p-6 sm:grid-cols-2"><div><dt class="text-slate-500">الاسم القانوني</dt><dd><%= @supplier.legal_name.presence || "—" %></dd></div><div><dt class="text-slate-500">جهة الاتصال</dt><dd><%= @supplier.contact_person.presence || "—" %></dd></div><div><dt class="text-slate-500">الهاتف</dt><dd dir="ltr"><%= @supplier.phone.presence || "—" %></dd></div><div><dt class="text-slate-500">البريد</dt><dd dir="ltr"><%= @supplier.email.presence || "—" %></dd></div><div><dt class="text-slate-500">شروط الدفع</dt><dd><%= @supplier.payment_terms.presence || "—" %></dd></div><div><dt class="text-slate-500">مدة التوريد</dt><dd><%= @supplier.lead_time_days ? "#{@supplier.lead_time_days} يوم" : "—" %></dd></div></dl>
  <h2 class="mt-8 text-2xl font-black">سجل أوامر الشراء</h2><div class="mt-3 overflow-x-auto rounded-2xl bg-white"><table class="w-full min-w-[650px] text-right"><thead><tr><th class="p-4">الأمر</th><th>الحالة</th><th>الإجمالي</th><th>المتوقع</th></tr></thead><tbody><% @supplier.purchase_orders.order(created_at: :desc).limit(30).each do |order| %><tr class="border-t"><td class="p-4"><%= link_to order.number, admin_purchase_order_path(order), class: "font-bold text-pharmacy-700" %></td><td><%= order.status %></td><td><%= number_to_currency(order.total_cents / 100.0, unit: "ج.م") %></td><td><%= order.expected_at || "—" %></td></tr><% end %></tbody></table></div>
</div>
