<% content_for :title, "الموردون" %>
<div class="mx-auto max-w-7xl px-4 py-10">
  <div class="flex flex-wrap items-center justify-between gap-4"><h1 class="text-3xl font-black">الموردون</h1><%= link_to "مورد جديد", new_admin_supplier_path, class: "rounded-xl bg-pharmacy-700 px-5 py-3 font-bold text-white" %></div>
  <%= form_with url: admin_suppliers_path, method: :get, class: "mt-6 grid gap-3 rounded-2xl bg-white p-4 sm:grid-cols-3" do |f| %>
    <%= f.search_field :q, value: params[:q], placeholder: "الاسم أو الكود أو جهة الاتصال", class: "rounded-xl border p-3" %>
    <%= f.select :active, [["كل الحالات", ""], ["نشط", "true"], ["متوقف", "false"]], { selected: params[:active] }, class: "rounded-xl border p-3" %>
    <%= f.submit "بحث", class: "rounded-xl bg-slate-900 p-3 text-white" %>
  <% end %>
  <p class="mt-4"><%= @pagy.count %> مورد</p>
  <div class="mt-4 overflow-x-auto rounded-2xl bg-white"><table class="w-full min-w-[760px] text-right"><thead class="bg-slate-50"><tr><th class="p-4">المورد</th><th>الكود</th><th>الاتصال</th><th>مدة التوريد</th><th>الحالة</th></tr></thead><tbody>
    <% @suppliers.each do |supplier| %><tr class="border-t"><td class="p-4"><%= link_to supplier.name, admin_supplier_path(supplier), class: "font-black text-pharmacy-700" %><small class="block"><%= supplier.legal_name %></small></td><td dir="ltr"><%= supplier.code %></td><td><%= supplier.contact_person.presence || "—" %><small class="block" dir="ltr"><%= supplier.phone %></small></td><td><%= supplier.lead_time_days ? "#{supplier.lead_time_days} يوم" : "—" %></td><td><%= supplier.active? ? "نشط" : "متوقف" %></td></tr><% end %>
  </tbody></table></div>
</div>
