<%= form_with model: [ :admin, ingredient ], class: "grid gap-4 rounded-2xl bg-white p-6" do |form| %>
  <% if ingredient.errors.any? %><div class="rounded-xl bg-rose-50 p-4 text-rose-900"><ul><% ingredient.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div><%= form.label :code, "الرمز الثابت (حروف إنجليزية كبيرة وأرقام وشرطات)" %><%= form.text_field :code, required: true, dir: "ltr", class: "mt-1 w-full rounded-xl border p-3" %></div>
  <div><%= form.label :name, "الاسم" %><%= form.text_field :name, required: true, class: "mt-1 w-full rounded-xl border p-3" %></div>
  <div><%= form.label :notes, "ملاحظات داخلية" %><%= form.text_area :notes, rows: 3, class: "mt-1 w-full rounded-xl border p-3" %></div>
  <label class="flex items-center gap-2 font-bold"><%= form.check_box :active %> نشطة للمطابقة</label>
  <%= form.submit "حفظ", class: "rounded-xl bg-pharmacy-700 px-5 py-3 font-black text-white" %>
<% end %>
