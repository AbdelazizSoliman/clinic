<% content_for :title, @ingredient.name %>
<div class="mx-auto max-w-4xl px-4 py-10">
  <%= link_to "← المواد الفعالة", admin_active_ingredients_path, class: "font-bold text-pharmacy-700" %>
  <header class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-2xl bg-white p-6">
    <div><h1 class="text-3xl font-black"><%= @ingredient.name %></h1><p class="mt-1 text-slate-600" dir="ltr"><%= @ingredient.code %></p></div>
    <div class="flex gap-2">
      <%= link_to "تعديل", edit_admin_active_ingredient_path(@ingredient), class: "rounded-xl border px-4 py-2 font-bold" %>
      <% if @ingredient.active? %><%= button_to "إيقاف", deactivate_admin_active_ingredient_path(@ingredient), method: :patch, class: "rounded-xl border px-4 py-2 font-bold" %><% end %>
    </div>
  </header>
  <% if @ingredient.notes.present? %><p class="mt-4 rounded-2xl bg-white p-5"><%= @ingredient.notes %></p><% end %>
  <section class="mt-6 rounded-2xl bg-white p-6">
    <h2 class="text-xl font-black">المنتجات المرتبطة</h2>
    <ul class="mt-3 space-y-2">
      <% @products.each do |link| %><li class="rounded-xl border p-3"><%= link_to link.product.name, admin_product_path(link.product), class: "font-bold text-pharmacy-700" %> <span class="text-sm text-slate-600"><%= [ link.strength, link.unit ].compact_blank.join(" ") %></span></li><% end %>
      <% if @products.empty? %><li class="text-slate-600">لا توجد منتجات مرتبطة بعد.</li><% end %>
    </ul>
  </section>
</div>
