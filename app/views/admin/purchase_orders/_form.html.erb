<%= form_with model: [:admin, purchase_order], class: "grid gap-5 rounded-2xl bg-white p-6" do |f| %><% if purchase_order.errors.any? %><div class="rounded-xl bg-rose-50 p-4"><% purchase_order.errors.full_messages.each do |message| %><p><%= message %></p><% end %></div><% end %><%= f.hidden_field :lock_version %><div><%= f.label :supplier_id, "المورد النشط" %><%= f.collection_select :supplier_id, Supplier.active.order(:name), :id, :name, { prompt: "اختر المورد" }, required: true, class: "mt-1 w-full rounded-xl border p-3" %></div><div><%= f.label :expected_at, "تاريخ التوريد المتوقع" %><%= f.date_field :expected_at, class: "mt-1 w-full rounded-xl border p-3" %></div><div><%= f.label :notes, "ملاحظات للمورد" %><%= f.text_area :notes, rows: 3, class: "mt-1 w-full rounded-xl border p-3" %></div><div><%= f.label :internal_notes, "ملاحظات داخلية" %><%= f.text_area :internal_notes, rows: 3, class: "mt-1 w-full rounded-xl border p-3" %></div><%= f.submit purchase_order.persisted? ? "حفظ المسودة" : "إنشاء المسودة", class: "rounded-xl bg-pharmacy-700 px-5 py-3 font-bold text-white" %><% end %>
