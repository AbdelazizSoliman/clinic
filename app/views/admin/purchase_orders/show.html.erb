<% content_for :title, @purchase_order.number %>
<div class="mx-auto max-w-7xl px-4 py-10">
  <div class="flex flex-wrap items-start justify-between gap-4"><div><p class="text-sm text-slate-500">أمر شراء</p><h1 class="text-3xl font-black" dir="ltr"><%= @purchase_order.number %></h1><p class="mt-2"><%= @purchase_order.supplier.name %> · <strong><%= @purchase_order.status %></strong></p></div><div class="flex flex-wrap gap-2"><% if @purchase_order.draft? %><%= link_to "تعديل البيانات", edit_admin_purchase_order_path(@purchase_order), class: "rounded-xl border px-4 py-2" %><%= button_to "إرسال للاعتماد", submit_admin_purchase_order_path(@purchase_order), method: :patch, params: { lock_version: @purchase_order.lock_version }, class: "rounded-xl bg-pharmacy-700 px-4 py-2 text-white" %><% end %><% if @purchase_order.submitted? && current_user.can_approve_purchasing? %><%= button_to "اعتماد", approve_admin_purchase_order_path(@purchase_order), method: :patch, params: { lock_version: @purchase_order.lock_version }, class: "rounded-xl bg-emerald-700 px-4 py-2 text-white" %><% end %><% if @purchase_order.received? %><%= button_to "إغلاق", close_admin_purchase_order_path(@purchase_order), method: :patch, params: { lock_version: @purchase_order.lock_version }, class: "rounded-xl bg-slate-900 px-4 py-2 text-white" %><% end %></div></div>

  <dl class="mt-6 grid gap-4 rounded-2xl bg-white p-6 sm:grid-cols-4"><div><dt class="text-slate-500">أنشأه</dt><dd><%= @purchase_order.created_by.full_name %></dd></div><div><dt class="text-slate-500">اعتمده</dt><dd><%= @purchase_order.approved_by&.full_name || "—" %></dd></div><div><dt class="text-slate-500">التوريد المتوقع</dt><dd><%= @purchase_order.expected_at || "—" %></dd></div><div><dt class="text-slate-500">المتبقي</dt><dd><%= @purchase_order.outstanding_quantity %></dd></div><div><dt class="text-slate-500">الإجمالي</dt><dd><%= number_to_currency(@purchase_order.total_cents / 100.0, unit: "ج.م") %></dd></div><div><dt class="text-slate-500">العملة</dt><dd><%= @purchase_order.currency %></dd></div><div class="sm:col-span-2"><dt class="text-slate-500">ملاحظات</dt><dd><%= @purchase_order.notes.presence || "—" %></dd></div></dl>

  <h2 class="mt-8 text-2xl font-black">البنود</h2>
  <div class="mt-3 overflow-x-auto rounded-2xl bg-white"><table class="w-full min-w-[950px] text-right"><thead class="bg-slate-50"><tr><th class="p-4">المنتج</th><th>SKU وقت الإرسال</th><th>المطلوب</th><th>المستلم</th><th>المتبقي</th><th>تكلفة الوحدة</th><th>الإجمالي</th><th></th></tr></thead><tbody><% @purchase_order.items.order(:id).each do |item| %><tr class="border-t"><td class="p-4"><%= item.product_name_snapshot %></td><td dir="ltr"><%= item.sku_snapshot.presence || "—" %></td><td><%= item.ordered_quantity %></td><td><%= item.received_quantity %></td><td><%= item.outstanding_quantity %></td><td><%= number_to_currency(item.unit_cost_cents / 100.0, unit: "ج.م") %></td><td><%= number_to_currency(item.line_total_cents / 100.0, unit: "ج.م") %></td><td><% if @purchase_order.draft? %><%= form_with model: item, url: admin_purchase_order_item_path(@purchase_order, item), method: :patch, class: "flex items-center gap-2" do |f| %><%= f.hidden_field :lock_version %><%= f.number_field :ordered_quantity, min: 1, class: "w-20 rounded border p-2", title: "الكمية" %><%= f.number_field :unit_cost, value: item.unit_cost_cents / 100.0, min: 0, step: 0.01, class: "w-24 rounded border p-2", title: "التكلفة" %><%= f.submit "حفظ", class: "rounded bg-slate-800 px-3 py-2 text-white" %><% end %><%= button_to "حذف", admin_purchase_order_item_path(@purchase_order, item), method: :delete, class: "mt-2 text-rose-700" %><% end %></td></tr><% end %></tbody></table></div>

  <% if @purchase_order.draft? %>
    <section class="mt-8 rounded-2xl bg-white p-6"><h2 class="text-xl font-black">إضافة منتج</h2><%= form_with url: admin_purchase_order_path(@purchase_order), method: :get, class: "mt-4 flex gap-2" do |f| %><%= f.search_field :product_q, value: params[:product_q], placeholder: "ابحث بالاسم العربي أو الإنجليزي أو SKU أو الباركود", class: "w-full rounded-xl border p-3" %><%= f.submit "بحث", class: "rounded-xl bg-slate-900 px-5 text-white" %><% end %><div class="mt-4 grid gap-3"><% @product_results.each do |product| %><%= form_with scope: :purchase_order_item, url: admin_purchase_order_items_path(@purchase_order), class: "grid items-end gap-2 rounded-xl border p-3 sm:grid-cols-5" do |f| %><div class="sm:col-span-2"><strong><%= product.name %></strong><small class="block" dir="ltr"><%= product.sku %></small><%= f.hidden_field :product_id, value: product.id %></div><div><%= f.label :ordered_quantity, "الكمية" %><%= f.number_field :ordered_quantity, min: 1, value: 1, required: true, class: "mt-1 w-full rounded border p-2" %></div><div><%= f.label :unit_cost, "تكلفة الوحدة ج.م" %><%= f.number_field :unit_cost, min: 0, step: 0.01, value: product.cost_price, required: true, class: "mt-1 w-full rounded border p-2" %></div><%= f.submit "إضافة", class: "rounded bg-pharmacy-700 p-2 text-white" %><% end %><% end %></div></section>
  <% end %>

  <% if @purchase_order.receivable? %>
    <section class="mt-8 rounded-2xl border-2 border-emerald-200 bg-white p-6"><h2 class="text-xl font-black">تثبيت استلام بالتشغيلات</h2><p class="mt-2 text-sm text-slate-600">كل كمية مستلمة تنشئ تشغيلة بهوية وتاريخ صلاحية إلزاميين. يمكن تقسيم البند إلى تشغيلات إضافية عبر التكامل البرمجي.</p><%= form_with url: admin_purchase_order_receipts_path(@purchase_order), method: :post, class: "mt-5 grid gap-4" do |f| %><%= hidden_field_tag :idempotency_key, @idempotency_key %><%= hidden_field_tag :lock_version, @purchase_order.lock_version %><% @purchase_order.items.select { |item| item.outstanding_quantity.positive? }.each do |item| %><fieldset class="grid items-end gap-2 rounded-xl border p-4 sm:grid-cols-4"><legend class="font-bold"><%= item.product_name_snapshot %> — المتبقي <%= item.outstanding_quantity %></legend><div><%= label_tag "quantities_#{item.id}", "الكمية" %><%= number_field_tag "quantities[#{item.id}]", 0, min: 0, max: item.outstanding_quantity, id: "quantities_#{item.id}", class: "mt-1 w-full rounded-xl border p-3" %></div><div><%= label_tag "batch_#{item.id}", "رقم التشغيلة" %><%= text_field_tag "batches[#{item.id}][0][batch_number]", nil, id: "batch_#{item.id}", dir: "ltr", class: "mt-1 w-full rounded-xl border p-3" %></div><div><%= label_tag "expiry_#{item.id}", "تاريخ الصلاحية" %><%= date_field_tag "batches[#{item.id}][0][expiry_date]", nil, id: "expiry_#{item.id}", min: Date.current, class: "mt-1 w-full rounded-xl border p-3" %></div><%= hidden_field_tag "batches[#{item.id}][0][quantity]", "", data: { batch_quantity_for: item.id } %><p class="text-xs text-slate-500 sm:col-span-4">تُستخدم كمية البند نفسها لهذه التشغيلة.</p></fieldset><% end %><div><%= label_tag :supplier_document_number, "رقم مستند المورد" %><%= text_field_tag :supplier_document_number, nil, class: "mt-1 w-full rounded-xl border p-3", dir: "ltr" %></div><div><%= label_tag :notes, "ملاحظات الاستلام" %><%= text_area_tag :notes, nil, rows: 2, class: "mt-1 w-full rounded-xl border p-3" %></div><%= f.submit "تثبيت التشغيلات وتحديث المخزون", class: "rounded-xl bg-emerald-700 px-5 py-3 font-bold text-white", data: { turbo_confirm: "سيتم إنشاء تشغيلات وحركات مخزون غير قابلة للحذف. متابعة؟" } %><% end %></section>
  <% end %>

  <% if %w[draft submitted approved partially_received].include?(@purchase_order.status) %><section class="mt-8 rounded-2xl bg-rose-50 p-6"><h2 class="font-black">إلغاء أمر الشراء</h2><p class="text-sm">لا يعكس الإلغاء أي مخزون تم استلامه سابقًا.</p><%= form_with url: cancel_admin_purchase_order_path(@purchase_order), method: :patch, class: "mt-3 flex flex-wrap gap-2" do |f| %><%= hidden_field_tag :lock_version, @purchase_order.lock_version %><%= text_field_tag :reason, nil, required: true, placeholder: "سبب الإلغاء", class: "min-w-64 flex-1 rounded-xl border p-3" %><%= f.submit "إلغاء الأمر", class: "rounded-xl bg-rose-700 px-4 text-white", data: { turbo_confirm: "تأكيد الإلغاء؟" } %><% end %></section><% end %>

  <div class="mt-8 grid gap-6 lg:grid-cols-2"><section><h2 class="text-xl font-black">إيصالات الاستلام</h2><div class="mt-3 space-y-3"><% @receipts.each do |receipt| %><article class="rounded-xl bg-white p-4"><strong dir="ltr"><%= receipt.reference %></strong><span> · <%= l(receipt.received_at, format: :short) %> · <%= receipt.received_by.full_name %></span><ul class="mt-2"><% receipt.items.each do |line| %><li><%= line.purchase_order_item.product_name_snapshot %>: <%= line.quantity %> × <%= number_to_currency(line.unit_cost_cents / 100.0, unit: "ج.م") %></li><% end %></ul></article><% end %></div></section><section><h2 class="text-xl font-black">الخط الزمني</h2><ol class="mt-3 space-y-3"><% @events.each do |event| %><li class="rounded-xl bg-white p-4"><strong><%= event.event_type %></strong><span> · <%= event.actor&.full_name || "النظام" %> · <%= l(event.created_at, format: :short) %></span><small class="block"><%= [event.from_status, event.to_status].compact.join(" ← ") %></small></li><% end %></ol></section></div>
</div>
