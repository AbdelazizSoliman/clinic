<% content_for :title, "أوامر الشراء" %><div class="mx-auto max-w-7xl px-4 py-10">
  <div class="flex flex-wrap items-center justify-between gap-4"><h1 class="text-3xl font-black">أوامر الشراء</h1><%= link_to "أمر شراء جديد", new_admin_purchase_order_path, class: "rounded-xl bg-pharmacy-700 px-5 py-3 font-bold text-white" %></div>
  <%= form_with url: admin_purchase_orders_path, method: :get, class: "mt-6 grid gap-3 rounded-2xl bg-white p-4 sm:grid-cols-3" do |f| %><%= f.search_field :q, value: params[:q], placeholder: "رقم الأمر أو المورد", class: "rounded-xl border p-3" %><%= f.select :status, [["كل الحالات", ""]] + PurchaseOrder.statuses.keys.map { |s| [s, s] }, { selected: params[:status] }, class: "rounded-xl border p-3" %><%= f.submit "تطبيق", class: "rounded-xl bg-slate-900 p-3 text-white" %><% end %>
  <p class="mt-4"><%= @pagy.count %> أمر شراء</p><div class="mt-4 overflow-x-auto rounded-2xl bg-white"><table class="w-full min-w-[900px] text-right"><thead class="bg-slate-50"><tr><th class="p-4">الأمر</th><th>المورد</th><th>الحالة</th><th>المطلوب</th><th>المستلم</th><th>المتبقي</th><th>الإجمالي</th><th>المتوقع</th></tr></thead><tbody><% @purchase_orders.each do |order| %><tr class="border-t"><td class="p-4"><%= link_to order.number, admin_purchase_order_path(order), class: "font-black text-pharmacy-700" %></td><td><%= order.supplier.name %></td><td><%= order.status %></td><td><%= order.items.sum(:ordered_quantity) %></td><td><%= order.items.sum(:received_quantity) %></td><td><%= order.outstanding_quantity %></td><td><%= number_to_currency(order.total_cents / 100.0, unit: "ج.م") %></td><td><%= order.expected_at || "—" %><%= " · متأخر" if order.expected_at && order.expected_at < Date.current && order.receivable? %></td></tr><% end %></tbody></table></div>
</div>
