<% content_for :title, "قواعد سلامة الدواء" %>
<div class="mx-auto max-w-7xl px-4 py-10">
  <div class="flex flex-wrap items-center justify-between gap-4"><h1 class="text-3xl font-black">قواعد سلامة الدواء</h1><%= link_to "قاعدة جديدة", new_admin_drug_safety_rule_path, class: "rounded-xl bg-pharmacy-700 px-5 py-3 font-bold text-white" %></div>
  <p class="mt-2 rounded-xl bg-amber-50 p-4 text-sm">قواعد معدّة محليًا لدعم قرار الصيدلي فقط. لا تمثل مرجعًا دوائيًا معتمدًا، ولا تحتوي على أي شيفرة أو استعلام قابل للتنفيذ.</p>
  <%= form_with url: admin_drug_safety_rules_path, method: :get, class: "mt-6 grid gap-3 rounded-2xl bg-white p-4 sm:grid-cols-4" do |f| %>
    <%= f.select :rule_type, [["كل الأنواع", ""]] + DrugSafetyRule.rule_types.keys.map { |key| [ DrugSafety::RULE_TYPE_LABELS[key], key ] }, { selected: params[:rule_type] }, class: "rounded-xl border p-3" %>
    <%= f.select :severity, [["كل المستويات", ""]] + DrugSafetyRule.severities.keys.map { |key| [ DrugSafety::SEVERITY_LABELS[key], key ] }, { selected: params[:severity] }, class: "rounded-xl border p-3" %>
    <%= f.select :active, [["كل الحالات", ""], ["نشطة", "true"], ["غير نشطة", "false"]], { selected: params[:active] }, class: "rounded-xl border p-3" %>
    <%= f.submit "تطبيق", class: "rounded-xl bg-slate-900 p-3 text-white" %>
  <% end %>
  <p class="mt-4"><%= @pagy.count %> قاعدة</p>
  <div class="mt-4 overflow-x-auto rounded-2xl bg-white"><table class="w-full min-w-[860px] text-right"><thead class="bg-slate-50"><tr><th class="p-4">القاعدة</th><th>النوع</th><th>الخطورة</th><th>يوقف الصرف</th><th>الإصدار</th><th>الحالة</th></tr></thead><tbody>
    <% @rules.each do |rule| %><tr class="border-t"><td class="p-4"><%= link_to rule.arabic_label, admin_drug_safety_rule_path(rule), class: "font-black text-pharmacy-700" %><small class="block" dir="ltr"><%= rule.code %></small></td><td><%= rule.rule_type_label %></td><td><%= safety_severity_badge(rule.severity) %></td><td><%= rule.blocking? ? "نعم" : "لا" %></td><td dir="ltr">v<%= rule.version %></td><td><%= rule.active? ? "نشطة" : (rule.published? ? "متقاعدة" : "مسودة") %></td></tr><% end %>
  </tbody></table></div>
</div>
