<div class="mx-auto max-w-7xl px-4 py-10">
  <div class="flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-3xl font-black">التشغيلات والصلاحية</h1><p class="text-slate-600">المصدر التفصيلي للمخزون الدوائي وترتيب FEFO.</p></div><%= link_to "لوحة تقارير التشغيلات", admin_reports_batches_path, class: "rounded-xl bg-slate-900 px-4 py-2 text-white" %></div>
  <nav class="mt-5 flex flex-wrap gap-2"><%= link_to "الكل", admin_inventory_batches_path, class: "rounded-xl border px-4 py-2" %><%= link_to "قرب الصلاحية", admin_inventory_batches_path(state: "near_expiry"), class: "rounded-xl border px-4 py-2" %><%= link_to "منتهية", admin_inventory_batches_path(state: "expired"), class: "rounded-xl border px-4 py-2" %><%= link_to "معزولة", admin_inventory_batches_path(state: "quarantined"), class: "rounded-xl border px-4 py-2" %></nav>
  <div class="mt-6 overflow-x-auto rounded-2xl bg-white"><table class="w-full min-w-[900px] text-right"><thead><tr><th class="p-4">التشغيلة</th><th>المنتج</th><th>المورد</th><th>الصلاحية</th><th>الحالة</th><th>فعلي</th><th>محجوز</th><th>متاح</th></tr></thead><tbody><% @batches.each do |batch| %><tr class="border-t"><td class="p-4"><%= link_to batch.batch_number, admin_inventory_batch_path(batch), class: "font-bold text-pharmacy-700", dir: "ltr" %></td><td><%= batch.product.name %></td><td><%= batch.supplier&.name || "رصيد مرحّل" %></td><td><%= batch.expiry_date %></td><td><%= batch.lifecycle_status %></td><td><%= batch.on_hand_quantity %></td><td><%= batch.reserved_quantity %></td><td><%= batch.available_quantity %></td></tr><% end %></tbody></table></div><div class="mt-5"><%== @pagy.series_nav if @pagy.pages > 1 %></div>
</div>
