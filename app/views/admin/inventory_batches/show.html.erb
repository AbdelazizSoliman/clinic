<div class="mx-auto max-w-6xl px-4 py-10">
  <div><p class="text-slate-500">تتبّع تشغيلة</p><h1 class="text-3xl font-black" dir="ltr"><%= @batch.batch_number %></h1><p><%= @batch.product.name %> · <%= @batch.lifecycle_status %></p></div>
  <dl class="mt-6 grid gap-4 rounded-2xl bg-white p-6 sm:grid-cols-4"><div><dt>الصلاحية</dt><dd><%= @batch.expiry_date %></dd></div><div><dt>المورد</dt><dd><%= @batch.supplier&.name || "—" %></dd></div><div><dt>الإيصال</dt><dd><%= @batch.purchase_receipt&.reference || "رصيد مرحّل" %></dd></div><div><dt>التكلفة</dt><dd><%= @batch.unit_cost_cents ? number_to_currency(@batch.unit_cost_cents / 100.0, unit: "ج.م") : "—" %></dd></div><div><dt>الأصلية</dt><dd><%= @batch.original_quantity %></dd></div><div><dt>الفعلية</dt><dd><%= @batch.on_hand_quantity %></dd></div><div><dt>المحجوزة</dt><dd><%= @batch.reserved_quantity %></dd></div><div><dt>المتاحة</dt><dd><%= @batch.available_quantity %></dd></div></dl>
  <div class="mt-6 grid gap-5 lg:grid-cols-2"><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">تعديل مضبوط</h2><%= form_with url: adjust_admin_inventory_batch_path(@batch), class: "mt-3 grid gap-3" do %><%= hidden_field_tag :lock_version, @batch.lock_version %><%= select_tag :movement_type, options_for_select([["تالف","damaged"],["فاقد","manual_decrease"],["زيادة تصحيح","correction"],["انتهاء صلاحية","expired"]]), class: "rounded-xl border p-3" %><%= number_field_tag :quantity, 1, min: 1, required: true, class: "rounded-xl border p-3" %><%= text_field_tag :reason, nil, required: true, placeholder: "السبب", class: "rounded-xl border p-3" %><%= submit_tag "تسجيل الحركة", class: "rounded-xl bg-slate-900 p-3 text-white" %><% end %></section><section class="rounded-2xl bg-white p-5"><h2 class="text-xl font-black">عزل الجودة</h2><% if @batch.quarantined? %><%= button_to "رفع العزل", release_quarantine_admin_inventory_batch_path(@batch), method: :patch, params: { reason: "اعتماد رفع عزل الجودة", lock_version: @batch.lock_version }, class: "mt-3 rounded-xl bg-emerald-700 px-4 py-3 text-white" %><% else %><%= form_with url: quarantine_admin_inventory_batch_path(@batch), method: :patch, class: "mt-3 flex gap-2" do %><%= hidden_field_tag :lock_version, @batch.lock_version %><%= text_field_tag :reason, nil, required: true, placeholder: "سبب العزل", class: "flex-1 rounded-xl border p-3" %><%= submit_tag "عزل", class: "rounded-xl bg-rose-700 px-4 text-white" %><% end %><% end %></section></div>
  <section class="mt-8"><h2 class="text-xl font-black">الحركات</h2><div class="mt-3 space-y-2"><% @movements.each do |movement| %><article class="rounded-xl bg-white p-4"><strong><%= movement.movement_type %></strong> · <%= movement.quantity_delta %> · <%= movement.reason %> · <%= l(movement.created_at, format: :short) %></article><% end %></div></section>
  <section class="mt-8"><h2 class="text-xl font-black">الحجوزات والطلبات والعملاء</h2><div class="mt-3 space-y-2"><% @allocations.each do |allocation| %><article class="rounded-xl bg-white p-4"><%= link_to allocation.order.number, staff_order_path(allocation.order), class: "font-bold" %> · <%= allocation.quantity %> · <%= allocation.order.user.full_name %> · <%= allocation.inventory_reservation.status %></article><% end %></div></section>
</div>
