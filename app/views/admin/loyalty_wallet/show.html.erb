<main class="mx-auto max-w-7xl px-4 py-8" dir="rtl"><h1 class="text-3xl font-black">إدارة الولاء والمحفظة</h1><section class="mt-6 rounded-xl bg-white p-5"><h2 class="font-black">قاعدة جديدة</h2><%= form_with model: LoyaltyRule.new, url: create_rule_admin_loyalty_wallet_path, class: "mt-3 grid gap-2 md:grid-cols-4" do |f| %><%= f.text_field :code, required: true, placeholder: "الكود", class: "border p-2" %><%= f.text_field :name, required: true, placeholder: "الاسم", class: "border p-2" %><%= f.select :rule_type, LoyaltyRule.rule_types.keys, {}, class: "border p-2" %><%= f.number_field :points_awarded, placeholder: "نقاط الكسب", class: "border p-2" %><%= f.number_field :spend_threshold_cents, placeholder: "حد الإنفاق بالقرش", class: "border p-2" %><%= f.number_field :redemption_points, placeholder: "نقاط التحويل", class: "border p-2" %><%= f.number_field :redemption_value_cents, placeholder: "قيمة التحويل", class: "border p-2" %><%= f.submit "إنشاء", class: "bg-slate-900 p-2 text-white" %><% end %></section><section class="mt-6 rounded-xl bg-white p-5"><h2 class="font-black">القواعد</h2><% @rules.each do |rule| %><p><%= rule.code %> · <%= rule.name %> · <%= rule.rule_type %> · <%= rule.active? ? "فعالة" : "متوقفة" %></p><% end %></section><section class="mt-6 rounded-xl bg-white p-5"><h2 class="font-black">تعديل مقيد</h2><form method="get"><input name="customer_id" placeholder="معرف العميل" class="border p-2"><button>عرض</button></form><% if @customer %><p class="my-3"><%= @customer.full_name %> · نقاط <%= @customer.loyalty_account&.points_balance.to_i %> · محفظة <%= @customer.wallet_account&.balance_cents.to_i %> قرش</p><%= form_with url: adjust_loyalty_admin_loyalty_wallet_path do %><input type="hidden" name="customer_id" value="<%= @customer.id %>"><input name="points" type="number" min="1" required><select name="direction"><option value="credit">إضافة</option><option value="debit">خصم</option></select><input name="reason" required placeholder="السبب"><input type="hidden" name="idempotency_key" value="admin-loyalty-<%= SecureRandom.uuid %>"><button>قيد نقاط</button><% end %><%= form_with url: adjust_wallet_admin_loyalty_wallet_path, class: "mt-3" do %><input type="hidden" name="customer_id" value="<%= @customer.id %>"><input name="amount_cents" type="number" min="1" required><select name="direction"><option value="credit">إضافة</option><option value="debit">خصم</option></select><input name="reason" required placeholder="السبب"><input type="hidden" name="idempotency_key" value="admin-wallet-<%= SecureRandom.uuid %>"><button>قيد محفظة</button><% end %><% end %></section></main>
