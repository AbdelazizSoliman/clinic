<% blocking = findings.select(&:blocks_dispensing?) %>
<% pending_ack = findings.select { |finding| finding.open? && finding.requires_acknowledgement? && !finding.blocking? } %>
<section class="mt-5 rounded-2xl border-2 <%= blocking.any? ? "border-rose-700 bg-rose-50" : "border-slate-300 bg-white" %> p-5" aria-labelledby="safety-summary-heading">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 id="safety-summary-heading" class="text-xl font-black">تنبيهات سلامة الدواء — دعم قرار للصيدلي</h2>
      <p class="mt-1 text-sm text-slate-700"><%= DrugSafety::DISCLAIMER %></p>
    </div>
    <% if evaluation %>
      <p class="text-xs text-slate-600">تقييم رقم <%= evaluation.sequence %> · <%= l(evaluation.evaluated_at, format: :short) %> · <%= findings.size %> تنبيهًا</p>
    <% end %>
  </div>
  <% if evaluation.nil? %>
    <p class="mt-3 rounded-xl bg-slate-50 p-3 text-sm">لم يُجرَ تقييم بعد لهذا السياق السريري.</p>
  <% elsif findings.empty? %>
    <p class="mt-3 rounded-xl bg-emerald-50 p-3 text-sm font-bold text-emerald-900">لا توجد تنبيهات مطابقة ضمن القواعد المُعدّة محليًا. هذا لا يعني خلو الحالة من مخاطر سريرية.</p>
  <% end %>
  <% if blocking.any? %>
    <p class="mt-3 rounded-xl border-2 border-rose-700 bg-white p-3 font-black text-rose-900" role="alert">
      <span aria-hidden="true">■</span> يوجد <%= blocking.size %> تنبيه حرج غير مُقَر. لا يمكن إتمام الصرف حتى يقرّه صيدلي أو يوثّق تجاوزه.
    </p>
  <% end %>
  <% if pending_ack.any? %>
    <p class="mt-3 rounded-xl border border-orange-600 bg-white p-3 font-bold text-orange-900">
      <span aria-hidden="true">◆</span> <%= pending_ack.size %> تنبيه مهم بانتظار إقرار الصيدلي.
    </p>
  <% end %>
</section>
