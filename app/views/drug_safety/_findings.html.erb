<% if findings.any? %>
  <section class="mt-4 rounded-xl border-2 border-slate-300 p-4" aria-labelledby="safety-<%= item.id %>-heading">
    <h3 id="safety-<%= item.id %>-heading" class="text-lg font-black">تنبيهات السلامة لهذا البند (<%= findings.size %>)</h3>
    <ul class="mt-3 space-y-3">
      <% findings.each do |finding| %>
        <li class="rounded-xl border p-4 <%= finding.blocks_dispensing? ? "border-rose-700" : "border-slate-200" %>">
          <div class="flex flex-wrap items-center gap-2">
            <%= safety_severity_badge(finding.severity) %>
            <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold"><%= finding.rule_type_label %></span>
            <%= safety_status_badge(finding) %>
            <% if finding.blocking? %><span class="rounded-full border-2 border-rose-700 px-3 py-1 text-xs font-black text-rose-900">يوقف الصرف</span><% end %>
            <span dir="ltr" class="text-xs text-slate-600"><%= finding.rule_identity %></span>
          </div>
          <p class="mt-3 leading-relaxed"><%= finding.explanation %></p>
          <% if finding.related_review_item_id && finding.related_review_item %>
            <p class="mt-1 text-sm text-slate-600">مرتبط ببند آخر: <%= finding.related_review_item.original_product.name %></p>
          <% end %>
          <% if finding.resolved? %>
            <p class="mt-2 rounded-lg bg-emerald-50 p-3 text-sm text-emerald-900">
              <%= finding.status_label %> بواسطة <%= finding.resolved_by&.full_name %> · <%= l(finding.resolved_at, format: :short) %>
              <% reason = finding.acknowledgements.order(:created_at).last&.reason %>
              <% if reason.present? %><span class="block">السبب الموثق: <%= reason %></span><% end %>
              <% if finding.carried_from_id %><span class="block text-xs">مُرحّل من تقييم سابق بنفس الوقائع السريرية.</span><% end %>
            </p>
          <% elsif finding.no_longer_applicable? %>
            <p class="mt-2 rounded-lg bg-slate-50 p-3 text-sm">لم يعد منطبقًا بعد تغيّر السياق السريري · <%= l(finding.resolved_at, format: :short) %></p>
          <% elsif can_resolve %>
            <%= form_with url: staff_safety_finding_path(finding), method: :patch, class: "mt-3 grid gap-2 rounded-lg bg-slate-50 p-3" do %>
              <%= hidden_field_tag :lock_version, finding.lock_version %>
              <div>
                <%= label_tag "reason_#{finding.id}", finding.blocking? ? "سبب موثق مطلوب *" : "سبب أو ملاحظة الصيدلي", class: "text-sm font-bold" %>
                <%= text_field_tag :reason, nil, id: "reason_#{finding.id}", required: finding.blocking?,
                      class: "mt-1 w-full rounded-lg border p-2", placeholder: "سبب سريري مختصر دون بيانات حساسة غير لازمة" %>
              </div>
              <div class="flex flex-wrap gap-2">
                <button name="safety_action" value="acknowledged" class="rounded-lg bg-slate-800 px-4 py-2 font-bold text-white">إقرار الاطلاع</button>
                <button name="safety_action" value="overridden" class="rounded-lg border-2 border-rose-700 px-4 py-2 font-bold text-rose-900">تجاوز موثق</button>
              </div>
              <p class="text-xs text-slate-600">الإقرار يسجل اطلاعك؛ التجاوز يسجل قرارك بالمضي رغم التنبيه. كلاهما يُحفظ باسمك ولا يُحذف.</p>
            <% end %>
          <% else %>
            <p class="mt-2 rounded-lg bg-slate-50 p-3 text-sm">الإقرار أو التجاوز متاح للصيدلي المرخص فقط.</p>
          <% end %>
          <details class="mt-2"><summary class="cursor-pointer text-sm font-bold">تفاصيل القاعدة المُعدّة محليًا</summary>
            <dl class="mt-2 space-y-1 text-sm text-slate-700">
              <div><dt class="inline font-bold">الاسم:</dt> <dd class="inline"><%= finding.rule_snapshot["arabic_label"] %></dd></div>
              <div><dt class="inline font-bold">الوصف:</dt> <dd class="inline"><%= finding.rule_snapshot["description"] %></dd></div>
              <% if finding.rule_snapshot["evidence_note"].present? %><div><dt class="inline font-bold">مصدر الإعداد:</dt> <dd class="inline"><%= finding.rule_snapshot["evidence_note"] %></dd></div><% end %>
              <div><dt class="inline font-bold">وقت التسجيل:</dt> <dd class="inline"><%= l(finding.created_at, format: :short) %></dd></div>
            </dl>
          </details>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
