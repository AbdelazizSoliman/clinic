<main class="mx-auto max-w-7xl px-4 py-8" dir="rtl"><h1 class="text-3xl font-black">المرتجعات واللوجستيات العكسية</h1><form action="<%= new_staff_return_path %>" class="mt-6 flex flex-wrap gap-2"><select name="source_type" class="rounded border p-2"><option value="order">طلب أونلاين</option><option value="pos">بيع نقطة بيع</option></select><input name="source_number" required class="rounded border p-2" placeholder="رقم الطلب أو الإيصال"><button class="rounded bg-slate-900 px-4 text-white">بحث وبدء</button></form><div class="mt-6 overflow-x-auto rounded-xl bg-white"><table class="w-full text-right"><thead><tr><th class="p-3">الرقم</th><th>المصدر</th><th>الحالة</th><th>الطالب</th></tr></thead><tbody><% @returns.each do |record| %><tr class="border-t"><td class="p-3"><%= link_to record.number, staff_return_path(record) %></td><td><%= record.source.number %></td><td><%= record.status %></td><td><%= record.requested_by.full_name %></td></tr><% end %></tbody></table></div></main>
