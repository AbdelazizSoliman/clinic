<% customer = return_request.source.is_a?(Order) ? return_request.source.user : return_request.source.customer %>
<% if customer&.customer? && (return_request.received? || return_request.refunded?) && current_user.can_refund_returns? %>
  <section class="mx-auto my-5 max-w-6xl rounded-xl border border-pharmacy-200 bg-white p-5 print:hidden" dir="rtl">
    <h2 class="font-black">استرداد إلى محفظة العميل</h2>
    <p class="text-sm">ينشئ سجل Refund وقيد محفظة مطابقاً؛ لا يوجد سحب نقدي.</p>
    <%= form_with url: refund_staff_return_path(return_request), class: "mt-3 flex flex-wrap gap-2" do %>
      <%= number_field_tag :amount_cents, return_request.remaining_refundable_cents, min: 1,
        max: return_request.remaining_refundable_cents, required: true, class: "rounded border p-2" %>
      <%= hidden_field_tag :payment_method, "wallet" %>
      <%= hidden_field_tag :idempotency_key, "wallet-refund-#{return_request.id}-#{SecureRandom.hex(6)}" %>
      <%= submit_tag "إيداع في المحفظة", class: "rounded bg-pharmacy-700 px-4 py-2 text-white" %>
    <% end %>
  </section>
<% end %>
