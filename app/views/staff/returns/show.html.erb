<main class="mx-auto max-w-6xl px-4 py-8" dir="rtl"><header class="rounded-xl bg-white p-6"><h1 class="text-3xl font-black">إيصال مرتجع <%= @return_request.number %></h1><p>المعاملة الأصلية: <%= @return_request.source.number %> · الحالة: <%= @return_request.status %></p><p>الموظف: <%= @return_request.requested_by.full_name %></p></header><section class="mt-5 rounded-xl bg-white p-5"><% @return_request.items.each do |item| %><article class="border-b py-3"><strong><%= item.product_name %></strong> — مطلوب <%= item.requested_quantity %>، معتمد <%= item.approved_quantity %>، مستلم <%= item.received_quantity %>، <%= item.refundable_amount_cents %> قرش، <%= item.disposition || "بانتظار القرار" %><% if item.pharmacist_inspection_required? && current_user.can_inspect_returns? && @return_request.approved? %><%= form_with url: inspect_item_staff_return_path(@return_request, item_id: item.id), method: :patch, class: "mt-2 flex gap-2 print:hidden" do %><select name="condition"><% ReturnItem.conditions.each_key { |v| %><option value="<%= v %>"><%= v.humanize %></option><% } %></select><select name="disposition"><% ReturnItem.dispositions.each_key { |v| %><option value="<%= v %>"><%= v.humanize %></option><% } %></select><button>تسجيل فحص الصيدلي</button><% end %><% end %></article><% end %></section><div class="mt-5 space-y-4 print:hidden"><% if @return_request.submitted? && current_user.can_review_returns? %><%= form_with url: review_staff_return_path(@return_request), method: :patch do %><button name="decision" value="approve" class="rounded bg-emerald-700 p-2 text-white">اعتماد</button> <button name="decision" value="reject" class="rounded bg-red-700 p-2 text-white">رفض</button><% end %><% end %><% if @return_request.approved? && current_user.can_disposition_returns? %><%= form_with url: receive_staff_return_path(@return_request), method: :post do %><input type="hidden" name="idempotency_key" value="receive-<%= @return_request.id %>"><% @return_request.items.each do |item| %><label><%= item.product_name %><select name="dispositions[<%= item.id %>]" class="m-2"><% ReturnItem.dispositions.each_key { |v| %><option value="<%= v %>"><%= v.humanize %></option><% } %></select></label><% end %><button class="rounded bg-pharmacy-700 p-2 text-white">استلام وترحيل</button><% end %><% end %><% if (@return_request.received? || @return_request.refunded?) && current_user.can_refund_returns? %><%= form_with url: refund_staff_return_path(@return_request), method: :post do %><input name="amount_cents" type="number" max="<%= @return_request.remaining_refundable_cents %>" required><select name="payment_method"><option value="cash">نقدي</option><option value="cash_on_delivery">عند التسليم</option><option value="external_card">بطاقة خارجية</option></select><input name="external_reference" placeholder="مرجع غير حساس"><input type="hidden" name="idempotency_key" value="refund-<%= @return_request.id %>-<%= SecureRandom.hex(6) %>"><button>تسجيل الاسترداد</button><% end %><% end %></div><button onclick="window.print()" class="mt-4 print:hidden">طباعة الإيصال</button></main>
