<main class="mx-auto max-w-5xl px-4 py-8" dir="rtl"><h1 class="text-3xl font-black">مرتجع جديد — <%= @source.number %></h1><%= form_with url: staff_returns_path(source_type: @source.is_a?(PosSale) ? "pos" : "order", source_number: @source.number), scope: :return_request, class: "mt-6 space-y-4" do |form| %><% @source.items.each_with_index do |item, index| %><section class="rounded-xl bg-white p-4"><h2 class="font-bold"><%= item.product_name %></h2><p>الكمية الأصلية: <%= item.quantity %></p><input type="hidden" name="items[<%= index %>][source_item_id]" value="<%= item.id %>"><input type="number" min="0" max="<%= item.quantity %>" value="0" name="items[<%= index %>][quantity]" class="m-2 w-24 rounded border p-2"><select name="items[<%= index %>][reason]" class="rounded border p-2"><% ReturnItem.reasons.each_key do |v| %><option value="<%= v %>"><%= v.humanize %></option><% end %></select><select name="items[<%= index %>][condition]" class="m-2 rounded border p-2"><% ReturnItem.conditions.each_key do |v| %><option value="<%= v %>"><%= v.humanize %></option><% end %></select></section><% end %><%= form.text_area :customer_notes, class: "w-full rounded border p-3" %><%= form.submit "إنشاء وإرسال", class: "rounded bg-pharmacy-700 px-5 py-3 text-white" %><% end %></main>
