<% content_for :title, "مراجعة #{@prescription.order.number}" %>
<div class="mx-auto max-w-7xl px-4 py-10">
  <%= link_to "← قائمة الروشتات", staff_prescriptions_path, class: "font-bold text-pharmacy-700" %>
  <header class="mt-5 rounded-3xl bg-white p-6 shadow-sm">
    <div class="flex flex-wrap justify-between gap-3">
      <div><h1 class="text-3xl font-black">مراجعة بنود الطلب <%= @prescription.order.number %></h1><p class="mt-2 text-slate-600">كل بند مقيد له قرار مستقل وسجل غير قابل للمحو.</p></div>
      <span class="rounded-full bg-pharmacy-100 px-4 py-2 font-black"><%= @review.status %></span>
    </div>
  </header>

  <div class="mt-6 grid gap-6 lg:grid-cols-[0.8fr_1.5fr]">
    <section class="rounded-2xl bg-white p-5">
      <h2 class="text-xl font-black">الملفات المرفوعة</h2>
      <div class="mt-4 grid gap-3"><% @prescription.images.each do |image| %><%= link_to image.filename.to_s, staff_prescription_file_path(@prescription, image.id), target: "_blank", rel: "noopener", class: "rounded-xl border p-4 font-bold" %><% end %></div>
      <p class="mt-5 rounded-xl bg-amber-50 p-4 text-sm">لا تسجل معلومات طبية غير لازمة. تنبيهات السلامة أدناه دعم قرار فقط ولا تحل محل حكمك السريري.</p>
      <% if current_user.can_manage_clinical_profiles? %>
        <%= link_to "البيانات السريرية المسجلة للمريض", staff_patient_clinical_profile_path(@prescription.user), class: "mt-4 block rounded-xl border p-3 text-center font-bold text-pharmacy-700" %>
      <% end %>
      <%= render "drug_safety/banner", findings: @safety_findings, evaluation: @safety_evaluation %>
    </section>

    <section class="space-y-5">
      <% @review_items.each do |item| %>
        <article class="rounded-2xl bg-white p-5 shadow-sm">
          <div class="flex flex-wrap justify-between gap-3">
            <div><h2 class="text-xl font-black"><%= item.original_product.name %> × <%= item.quantity %></h2><p class="text-sm text-slate-500">المنتج الموصوف محفوظ دائمًا · <%= number_to_currency(item.prescribed_unit_price_cents / 100.0, unit: "ج.م") %></p></div>
            <span class="rounded-full bg-slate-100 px-3 py-2 font-bold"><%= item.status %></span>
          </div>
          <% if item.dispensable? %>
            <div class="mt-4 rounded-xl bg-emerald-50 p-4"><strong>المنتج المصروف:</strong> <%= item.dispensed_product.name %> · <%= number_to_currency(item.dispensed_unit_price_cents / 100.0, unit: "ج.م") %><% if item.substituted? %><span class="mr-2 rounded bg-emerald-700 px-2 py-1 text-xs text-white">بديل علاجي</span><% end %></div>
          <% elsif item.rejected? %><div class="mt-4 rounded-xl bg-rose-50 p-4 text-rose-900">مرفوض: <%= item.reason %></div><% end %>

          <%= render "drug_safety/findings", item:, findings: safety_findings_for(@safety_findings, item),
                can_resolve: current_user.can_resolve_safety_findings? %>

          <% unless item.terminal? %>
            <% if item.pending? %><%= button_to "بدء مراجعة البند", start_staff_prescription_review_item_path(@prescription, item), method: :patch, params: { lock_version: item.lock_version }, class: "mt-4 rounded-xl border px-4 py-2 font-bold" %><% end %>
            <% if current_user.can_make_prescription_decisions? %>
              <%= form_with url: decide_staff_prescription_review_item_path(@prescription, item), method: :patch, class: "mt-4 grid gap-3 rounded-xl border p-4" do %>
                <%= hidden_field_tag :lock_version, item.lock_version %>
                <div><%= label_tag :reason, "سبب القرار *" %><%= text_field_tag :reason, nil, required: true, class: "mt-1 w-full rounded-xl border p-3" %></div>
                <div><%= label_tag :notes, "ملاحظات صيدلي مختصرة" %><%= text_area_tag :notes, nil, rows: 2, class: "mt-1 w-full rounded-xl border p-3" %></div>
                <div><%= label_tag :physician_instruction_reference, "مرجع تعليمات الطبيب — اختياري" %><%= text_field_tag :physician_instruction_reference, nil, class: "mt-1 w-full rounded-xl border p-3" %></div>
                <div data-controller="product-search" data-product-search-url-value="<%= staff_substitution_candidates_path %>" data-search-param-exclude_id="<%= item.original_product_id %>" data-search-param-field_id="substitute_<%= item.id %>">
                  <%= label_tag "substitute_search_#{item.id}", "ابحث عن بديل عند الاستبدال — بالاسم أو المادة الفعالة أو الكود" %>
                  <%= search_field_tag "substitute_search_#{item.id}", nil, id: "substitute_search_#{item.id}", autocomplete: "off",
                        data: { product_search_target: "input", action: "input->product-search#search keydown->product-search#navigate" },
                        class: "mt-1 w-full rounded-xl border p-3" %>
                  <span data-product-search-target="status" class="mt-1 hidden text-xs text-slate-500" role="status">جارٍ البحث…</span>
                  <div data-product-search-target="panel" class="mt-2 hidden rounded-xl border border-slate-200 p-3" aria-live="polite"></div>
                </div>
                <div class="grid gap-2 sm:grid-cols-3"><button name="decision" value="approved" class="rounded-xl bg-emerald-700 px-4 py-3 font-bold text-white">اعتماد الأصلي</button><button name="decision" value="substituted" class="rounded-xl bg-blue-700 px-4 py-3 font-bold text-white">اعتماد البديل</button><button name="decision" value="rejected" class="rounded-xl bg-rose-700 px-4 py-3 font-bold text-white">رفض البند</button></div>
              <% end %>
            <% end %>
          <% end %>

          <details class="mt-4"><summary class="cursor-pointer font-bold">الخط الزمني للقرار</summary><ol class="mt-2 space-y-2"><% item.decisions.order(:created_at).each do |decision| %><li class="border-r-2 pr-3 text-sm"><%= decision.from_status %> ← <%= decision.to_status %> · <%= decision.actor.full_name %> · <%= l(decision.created_at, format: :short) %></li><% end %></ol></details>
        </article>
      <% end %>
    </section>
  </div>
</div>
