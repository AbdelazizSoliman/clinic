<main class="mx-auto max-w-4xl px-4 py-10" dir="rtl"><h1 class="text-3xl font-black">طلب مرتجع للطلب <%= @order.number %></h1><p class="mt-2 text-slate-600">رسوم التوصيل غير قابلة للاسترداد افتراضياً.</p><%= form_with url: order_returns_path(@order), scope: :return_request, class: "mt-6 space-y-5" do |form| %><% @order.items.each_with_index do |item, index| %><% used = item.return_items.joins(:return_request).where.not(return_requests: { status: %i[rejected cancelled] }).sum(:requested_quantity) %><% remaining = item.quantity - used %><section class="rounded-2xl bg-white p-5 shadow-sm"><h2 class="font-bold"><%= item.product_name %></h2><p class="text-sm">المتاح: <%= remaining %></p><input type="hidden" name="items[<%= index %>][source_item_id]" value="<%= item.id %>"><div class="mt-3 grid gap-3 md:grid-cols-3"><input class="rounded border p-2" type="number" min="0" max="<%= remaining %>" value="0" name="items[<%= index %>][quantity]"><select class="rounded border p-2" name="items[<%= index %>][reason]"><% ReturnItem.reasons.each_key do |v| %><option value="<%= v %>"><%= v.humanize %></option><% end %></select><select class="rounded border p-2" name="items[<%= index %>][condition]"><% ReturnItem.conditions.each_key do |v| %><option value="<%= v %>"><%= v.humanize %></option><% end %></select></div></section><% end %><%= form.text_area :customer_notes, class: "w-full rounded border p-3", maxlength: 500, placeholder: "ملاحظات مختصرة" %><%= form.submit "إرسال طلب المرتجع", class: "rounded-xl bg-pharmacy-700 px-5 py-3 font-bold text-white" %><% end %></main>
